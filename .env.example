# --- Django ---
DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=*

# --- Database (optional; default SQLite) ---
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=crypton
# DATABASE_USER=postgres
# DATABASE_PASSWORD=
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432

# --- Market data ---
# If Binance API is unreachable from your network, set a proxy:
# BINANCE_PROXY=http://127.0.0.1:7890
# Or use a mirror:
# BINANCE_BASE_URL=https://api.binance.com
# Force fully synthetic offline data:
DEMO_MODE=1

# --- Worker ---
WORKER_AUTOSTART=1
PRICE_UPDATE_SECONDS=10
CANDLE_UPDATE_SECONDS=60
ANALYSIS_INTERVAL_SECONDS=300
MONITOR_INTERVAL_SECONDS=30

# --- AI / Learning ---
HISTORY_DAYS=45
AI_RETRAIN_THRESHOLD=25

# --- Paper trading ---
PAPER_TRADE_ENABLED=1
